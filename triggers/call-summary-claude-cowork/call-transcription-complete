#!/usr/bin/env bash
set -euo pipefail

urlencode() {
    local string="${1}"
    local encoded=""
    local pos char

    for ((pos = 0; pos < ${#string}; pos++)); do
        char="${string:${pos}:1}"
        case "${char}" in
            [a-zA-Z0-9.~_-])
                encoded+="${char}"
                ;;
            *)
                printf -v encoded '%s%%%02X' "${encoded}" "'${char}"
                ;;
        esac
    done

    printf '%s' "${encoded}"
}

CALL="${1:-${TUPLE_TRIGGER_CALL_ID:-}}"

PROMPT=$(cat <<'PROMPT'
A Tuple pair-programming call just finished, and you've been asked to summarize it.

## Find the call

If a `## Triggering call` section appears below, use that exact id and do not discover another call. Otherwise, for older Tuple versions that did not supply an id, run `tuple call current` if you're still on the call or take the most recent call from `tuple transcription list`.

## Read it

`tuple transcription show <id>` prints the full transcript with speaker names. Add `--with-events` if join/leave/screen events would help anchor decisions.

## Summarize

Produce:
- A concise executive summary
- Key decisions
- Action items, with owners when stated
- Open questions or loose ends
- Any useful follow-up message draft

Do not invent owners, decisions, or commitments. Use direct quotes only when they materially clarify the summary.

## Write it back to the call

Record the summary on the call itself so it's there in Tuple's Call History:

    tuple transcription set-title <id> "<a short, specific title for the whole call>"
    tuple transcription set-summary <id> "<your summary>"
PROMPT
)

if [ -n "${CALL}" ]; then
    printf -v PROMPT '%s\n\n## Triggering call\n\nSummarize this call and only this call:\n\n    %s\n\nDo not run `tuple call current` or select the newest stored call. If this id cannot be found, stop.\n' "${PROMPT}" "${CALL}"
fi

DEEPLINK="claude://cowork/new?q=$(urlencode "${PROMPT}")"

if [ "${CALL_SUMMARY_COWORK_DRY_RUN:-}" = "1" ]; then
    echo "call-summary-claude-cowork: dry run — would open ${DEEPLINK}"
    exit 0
fi

echo "call-summary-claude-cowork: opening Claude Cowork"
open "${DEEPLINK}"
